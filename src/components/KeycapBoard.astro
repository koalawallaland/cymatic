  </svg><img class="doodle " src="/doodles/lash-eye.webp" alt="" draggable="false" style="left:20%;top:23%;width:60%">`} /></div>
      <div class="tray dish" data-tray data-tray-name="halo eye dish" data-sound-kind="lacquer" aria-label="Blue halo eye dish"><Fragment set:html={`<svg class="art" viewBox="0 0 120 120" preserveAspectRatio="none" aria-hidden="true">

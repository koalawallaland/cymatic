---
// The room from across it: shoji, monitors, the lamp on the matcha board,
// a working pour-over and the notebook that holds the blog.
interface Props { posts: { id: string; title: string; date: string }[]; }
const { posts } = Astro.props;
---
<section class="scene" data-scene aria-label="A desk in front of shoji screens" data-no-type>
  <div class="stage" data-stage>
    <div class="wall" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
      <span class="glow g1"></span><span class="glow g2"></span>
    </div>
    <span class="neon vert n1" aria-hidden="true">樹脂</span>
    <span class="neon vert n2" aria-hidden="true">キーキャップ</span>
    <span class="neon kao" aria-hidden="true">(っ˘ω˘ς)</span>
    <a class="neon enter" href="/lab/"><b>入口 ENTER</b><small>THE LAB</small></a>

    <button type="button" class="pins" data-pins aria-label="Bulletin board with five blurry snapshots. Open it to look closer."><span class="cork"><img src="/desk/pins/p1.webp" width="409" height="480" alt="" /><img src="/desk/pins/p2.webp" width="360" height="480" alt="" /><img src="/desk/pins/p3.webp" width="480" height="385" alt="" /><img src="/desk/pins/p4.webp" width="480" height="360" alt="" /><img src="/desk/pins/p5.webp" width="294" height="480" alt="" /></span></button>

    <div class="deskback" aria-hidden="true"></div>

    <a class="mon m-up" href="/works/opening-nov-4/" aria-label="Monitor showing a cat: earlier version of this page"><span class="scr"><video autoplay loop muted playsinline poster="/cat-poster.webp" tabindex="-1"><source src="/cat.webm" type="video/webm" /><source src="/cat.mp4" type="video/mp4" /></video></span></a>
    <a class="mon m-cym" href="/works/cymatic-field/" aria-label="Monitor showing a cymatic pattern: open the cymatic field"><span class="scr"><canvas data-cym width="96" height="64"></canvas></span></a>
    <a class="mon m-lab" href="/lab/" aria-label="Monitor showing swirling resin: open the resin lab"><span class="scr swirl"></span></a>
    <a class="mon m-wall" href="/wall/" aria-label="Monitor showing graffiti: open the graffiti wall"><span class="scr tag"><svg viewBox="0 0 60 100" aria-hidden="true"><path d="M6 34q8-26 16-8q6 14 13-11q5-12 18 3" fill="none" stroke="#ff7ab8" stroke-width="5" stroke-linecap="round"/><path d="M7 54q14-8 44-3" fill="none" stroke="#58d8f5" stroke-width="4" stroke-linecap="round"/><path d="M11 76c5-9 13 2 7 7c-6-5 2-15 7-7M33 69l6 13l6-13" fill="none" stroke="#d8ff3e" stroke-width="3.500" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
    <button type="button" class="mon m-live" data-pocket aria-label="Monitor showing an equalizer: open the live beat pocket"><span class="scr eq"><i></i><i></i><i></i><i></i><i></i><i></i></span></button>

    <div class="desk" aria-hidden="true"></div>
    <div class="pool" data-pool aria-hidden="true"></div>
    <img class="books" src="/desk/books.webp" width="616" height="1075" alt="A stack of three books: Hyperpop by Julie Ackermann, Gritos de Neon by Kit Mackintosh and The Future Is Not Lost by Matt Bluemink." loading="lazy" decoding="async" draggable="false">

    <button type="button" class="lamp" data-lamp aria-pressed="true" aria-label="Lamp. Turn it off or on.">
      <svg viewBox="0 0 60 120" aria-hidden="true">
        <defs>
          <linearGradient id="dsShade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff2cf"/><stop offset="1" stop-color="#ffc877"/></linearGradient>
          <linearGradient id="dsGloss" x1="0" x2="1"><stop offset="0" stop-color="#f4eadf"/><stop offset=".4" stop-color="#fff"/><stop offset="1" stop-color="#d9cdbf"/></linearGradient>
        </defs>
        <rect x="10" y="3" width="40" height="52" rx="2" fill="url(#dsShade)"/>
        <path d="M14 3v52M18 3v52M22 3v52M26 3v52M30 3v52M34 3v52M38 3v52M42 3v52M46 3v52" stroke="#d99c55" stroke-width=".8" opacity=".55"/>
        <path d="M26 55h8q1 16 5 30q6 18 3 32H18q-3-14 3-32q4-14 5-30z" fill="url(#dsGloss)"/>
      </svg>
    </button>

    <button type="button" class="minikb" data-minikb aria-label="The matcha keyboard, lit by the lamp. Go to the keyboard up close."><span class="kbcase" data-mini></span></button>
    <div class="minitrays" data-minitrays aria-hidden="true"></div>

    <button type="button" class="book" data-book aria-label="Midori notebook. Open it to read the blog."><span class="cover"></span></button>

    <div class="pour" data-pour>
      <svg viewBox="-16 20 336 290">
        <defs>
          <linearGradient id="dsPink" x1="0" x2="1"><stop offset="0" stop-color="#f08dbb"/><stop offset=".38" stop-color="#ffc9e0"/><stop offset="1" stop-color="#e477aa"/></linearGradient>
          <linearGradient id="dsRose" x1="0" x2="1"><stop offset="0" stop-color="#c58f85"/><stop offset=".35" stop-color="#f3d6cd"/><stop offset="1" stop-color="#b98278"/></linearGradient>
          <linearGradient id="dsMatte" x1="0" x2="1"><stop offset="0" stop-color="#e9a9c0"/><stop offset=".3" stop-color="#fbd9e4"/><stop offset=".62" stop-color="#f8cfdc"/><stop offset="1" stop-color="#d98fac"/></linearGradient>
          <linearGradient id="dsPlate" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fde3eb"/><stop offset="1" stop-color="#f5c3d4"/></linearGradient>
          <linearGradient id="dsWood" x1="0" x2="1"><stop offset="0" stop-color="#9c6a3c"/><stop offset=".45" stop-color="#deb684"/><stop offset="1" stop-color="#b08049"/></linearGradient>
          <linearGradient id="dsGlass" x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity=".42"/><stop offset=".2" stop-color="#fff" stop-opacity=".08"/><stop offset=".8" stop-color="#fff" stop-opacity=".06"/><stop offset="1" stop-color="#fff" stop-opacity=".32"/></linearGradient>
          <filter id="dsSoft" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="5"/></filter>
          <clipPath id="dsCone"><path d="M112 118h76l-26 52h-24z"/></clipPath>
          <clipPath id="dsCarafe"><path d="M118 188h64q10 40 12 76q0 22-16 22h-56q-16 0-16-22q2-36 12-76z"/></clipPath>
          <clipPath id="dsCup"><path d="M226 216h52l-4 68q-1 8-10 8h-24q-9 0-10-8z"/></clipPath>
          <clipPath id="dsBody"><path d="M31 170C28 205 14 245 6 268Q3 284 20 284H78Q95 284 92 268C84 245 70 205 67 170Z"/></clipPath>
        </defs>
        <g aria-hidden="true" fill="#0d0612" opacity=".55" filter="url(#dsSoft)">
          <ellipse cx="46" cy="300" rx="66" ry="7"/><ellipse cx="176" cy="292" rx="52" ry="6"/><ellipse cx="278" cy="295" rx="30" ry="5"/>
        </g>
        <g transform="translate(26 0)">
          <!-- carafe -->
          <g class="hit" data-carafe role="button" tabindex="0" aria-label="Carafe. Pour a cup.">
            <rect x="84" y="170" width="132" height="124" fill="transparent"/>
            <g clip-path="url(#dsCarafe)"><rect data-coffee x="100" y="288" width="100" height="0" fill="#4b2413"/></g>
            <path d="M118 188h64q10 40 12 76q0 22-16 22h-56q-16 0-16-22q2-36 12-76z" fill="url(#dsGlass)" stroke="#f4f7ff" stroke-width="2.500"/>
            <path d="M113 212q-5 28-6 52" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".75"/>
          </g>
          <!-- matte pink dripper with grounds -->
          <g clip-path="url(#dsCone)"><ellipse data-grounds cx="150" cy="156" rx="30" ry="9" fill="#4b2d1d"/><rect data-water x="108" y="170" width="84" height="0" fill="rgba(112,66,35,.72)"/></g>
          <path d="M192 122q20 2 14 24q-5 14-22 10" fill="none" stroke="#e98bb6" stroke-width="7" stroke-linecap="round"/>
          <path d="M106 110q44 8 88 0l-30 66h-28z" fill="url(#dsPink)" fill-opacity=".94"/>
          <ellipse cx="150" cy="110" rx="44" ry="7" fill="#ffd9ea" stroke="#e88fba" stroke-width="1.500"/>
          <ellipse cx="150" cy="111" rx="37" ry="4.500" fill="#b65f8c"/>
          <path d="M120 128l20 42M134 124l10 46M166 124l-10 46M180 128l-20 42" stroke="#d96fa3" stroke-width="1.200" opacity=".55"/>
          <path d="M122 176h56q8 1 8 7v2q0 3-4 3h-64q-4 0-4-3v-2q0-6 8-7z" fill="url(#dsPink)"/>
          <!-- drip -->
          <circle class="drop" data-drop cx="150" cy="190" r="3" fill="#6f3a1b" opacity="0"/>
          <!-- stream from the kettle spout -->
          <path data-stream d="M134 98C142 99 150 106 150 124" fill="none" stroke="#c9eeff" stroke-width="3.500" stroke-linecap="round" opacity="0"/>
          <!-- tumbler -->
          <g class="hit" data-cup role="button" tabindex="0" aria-label="Almond rose tumbler. Take a sip.">
            <rect x="216" y="190" width="72" height="106" fill="transparent"/>
            <g clip-path="url(#dsCup)"><rect data-cupfill x="222" y="292" width="60" height="0" fill="#6a3417"/></g>
            <path d="M226 216h52l-4 68q-1 8-10 8h-24q-9 0-10-8z" fill="url(#dsRose)" fill-opacity=".5" stroke="#f6dcd5" stroke-width="2.500"/>
            <path d="M233 224l3 54" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".6"/>
            <path data-steam class="steam" d="M244 204q-7-10 0-20q7-10 0-20M260 204q-7-10 0-20q7-10 0-20" fill="none" stroke="#fff" stroke-width="2.500" stroke-linecap="round" opacity="0"/>
          </g>
        </g>
        <!-- base stays on the desk when the kettle lifts -->
        <g aria-hidden="true">
          <path d="M0 281h98l14 15H-14z" fill="url(#dsPlate)"/>
          <path d="M-14 296h126v5q0 2-2 2H-12q-2 0-2-2z" fill="#dd9fb7"/>
          <ellipse cx="4" cy="291" rx="8" ry="2.500" fill="#23141c"/>
          <ellipse cx="94" cy="291" rx="9" ry="3" fill="#fff4f8" stroke="#dda0b8"/>
        </g>
        <g class="kettle" data-kettle role="button" tabindex="0" aria-label="Kettle. Hold to pour water over the coffee.">
          <rect x="-16" y="146" width="146" height="142" fill="transparent"/>
          <!-- gooseneck, tapering from body to tip -->
          <path d="M76 256C84 261 90 268 94 266C104 262 104 240 106 214C107 190 108 168 112 158C113 154 117 151 124 150L125 155C120 156 118 159 117 163C114 175 114 195 113 216C111 246 111 274 94 277C87 278 80 274 73 268Z" fill="url(#dsMatte)" stroke="#d695af" stroke-width="1"/>
          <!-- angled wood handle -->
          <path d="M33 177L20 169Q13 166 10 174L-9 230Q-12 243-2 244Q6 245 9 236L28 199Q31 192 31 186Z" fill="url(#dsWood)"/>
          <path d="M16 176L-3 232M23 182L6 228" stroke="#8a5a30" stroke-width=".8" opacity=".45"/>
          <!-- matte conical body -->
          <path d="M31 170C28 205 14 245 6 268Q3 284 20 284H78Q95 284 92 268C84 245 70 205 67 170Z" fill="url(#dsMatte)"/>
          <g clip-path="url(#dsBody)">
            <path d="M38 174C36 206 26 240 18 276" fill="none" stroke="#fff" stroke-width="9" opacity=".32" filter="url(#dsSoft)"/>
            <rect x="0" y="276" width="100" height="10" fill="#c9829f" opacity=".5"/>
          </g>
          <!-- lid and wood knob -->
          <ellipse cx="49" cy="170" rx="18.500" ry="4" fill="#fde3ec" stroke="#dca0b8"/>
          <path d="M37 168v-6q0-1 1-1.500q11-4 22 0q1 .5 1 1.500v6q-12 4-24 0z" fill="url(#dsWood)"/>
          <ellipse cx="49" cy="160.500" rx="12" ry="3" fill="#e6c294"/>
        </g>
      </svg>
    </div>
  </div>
  <p class="said" data-said aria-live="polite">Hold the kettle to pour. Tap the notebook for the blog.</p>
  <nav class="rooms" aria-label="More rooms">
    <a href="/lab/">Resin lab</a><a href="/desk/">Koala's desk</a><a href="/wall/">Graffiti wall</a><a href="/shop/">Shop</a><a href="/works/">Experiments</a>
  </nav>
  <dialog class="snaps" data-snaps aria-label="Blurry snapshots">
    <div class="snapgrid"><figure><img src="/desk/pins/p1.webp" width="409" height="480" loading="lazy" alt="Blurry snapshot" /></figure><figure><img src="/desk/pins/p2.webp" width="360" height="480" loading="lazy" alt="Blurry snapshot" /></figure><figure><img src="/desk/pins/p3.webp" width="480" height="385" loading="lazy" alt="Blurry snapshot" /></figure><figure><img src="/desk/pins/p4.webp" width="480" height="360" loading="lazy" alt="Blurry snapshot" /></figure><figure><img src="/desk/pins/p5.webp" width="294" height="480" loading="lazy" alt="Blurry snapshot" /></figure></div>
    <form method="dialog"><button>Close</button></form>
  </dialog>
  <dialog class="spread" data-spread aria-label="Blog notebook">
    <div class="pages">
      <div class="page left">
        <h2>Blog</h2>
        <ul>{posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.title}</a><time>{p.date}</time></li>)}</ul>
      </div>
      <div class="page right" aria-hidden="true"></div>
    </div>
    <form method="dialog"><button>Close the notebook</button></form>
  </dialog>
</section>

<style>
  .scene { min-width: 0; }
  .stage { position: relative; container-type: inline-size; aspect-ratio: 4 / 5; width: 100%; margin-inline: auto; overflow: hidden; border-radius: 16px; background: #120a1c; box-shadow: 0 0 40px rgba(0,0,0,.55); isolation: isolate; }
  .stage > * { position: absolute; }

  /* shoji */
  .wall { inset: 0 0 38% 0; display: grid; grid-template-columns: repeat(4, 1fr); background: #150b1f; }
  .wall i { border-inline: .7cqw solid #1a0f19; background:
      repeating-linear-gradient(90deg, rgba(26,15,25,.92) 0 .35cqw, transparent .35cqw 6cqw),
      repeating-linear-gradient(0deg, rgba(26,15,25,.92) 0 .35cqw, transparent .35cqw 7.4cqw),
      linear-gradient(180deg, #cdbcc0, #e8d4bb 60%, #f2d2a6); filter: brightness(.62); }
  .glow { position: absolute; border-radius: 50%; filter: blur(5cqw); mix-blend-mode: screen; pointer-events: none; }
  .g1 { left: -6%; top: 2%; width: 56%; height: 70%; background: rgba(255,47,158,.55); }
  .g2 { right: -8%; top: 10%; width: 52%; height: 70%; background: rgba(34,230,255,.34); }

  .neon { margin: 0; padding: .28em .34em; color: #fff; background: rgba(10,4,20,.55); border: .22cqw solid rgba(255,255,255,.35); border-radius: 1cqw; font: 900 3.4cqw/1 'Zen Maru Gothic', 'Hiragino Maru Gothic ProN', sans-serif; text-decoration: none; text-shadow: 0 0 .4cqw #fff, 0 0 1.2cqw var(--n), 0 0 3cqw var(--n), 0 0 6cqw var(--n); box-shadow: 0 0 2cqw color-mix(in srgb, var(--n) 40%, transparent); }
  .vert { writing-mode: vertical-rl; text-orientation: upright; letter-spacing: .08em; }
  .n1 { --n: #ff2f9e; left: 4%; top: 4%; font-size: 5.6cqw; }
  .n2 { --n: #22e6ff; right: 3%; top: 3%; font-size: 2.4cqw; }
  .kao { --n: #c6ff00; left: 14%; top: 5%; font-size: 3cqw; white-space: nowrap; }
  .enter { --n: #ff4a3d; left: 53%; top: 3.5%; display: flex; flex-direction: column; align-items: center; gap: .3em; font-size: 4.2cqw; white-space: nowrap; animation: tube 5.2s linear infinite; }
  .enter b { font-weight: 900; }
  .enter small { font-size: .42em; letter-spacing: .2em; }
  .enter:focus-visible, .mon:focus-visible, .lamp:focus-visible, .minikb:focus-visible, .book:focus-visible { outline: .5cqw solid #fff; outline-offset: .5cqw; }
  @keyframes tube { 0%, 92%, 100% { opacity: 1; } 93% { opacity: .45; } 94% { opacity: 1; } 96% { opacity: .65; } 97% { opacity: 1; } }

  /* bulletin board: the images themselves are blurred, so no sharp copy is ever served */
  .pins { z-index: 2; left: 28.5%; top: 6.5%; width: 23.5%; height: 13.5%; padding: .7cqw; border: 0; border-radius: 1cqw; background: linear-gradient(150deg, #fff5fa, #f6cfe3); box-shadow: 0 1cqw 1.8cqw rgba(30,8,40,.5); cursor: pointer; }
  .pins:focus-visible { outline: .5cqw solid #fff; outline-offset: .5cqw; }
  .cork { display: flex; align-items: center; justify-content: center; gap: .5cqw; height: 100%; overflow: hidden; border-radius: .5cqw; background: radial-gradient(circle at 20% 30%, #a97c52 0 .15cqw, transparent .2cqw) 0 0 / 1.1cqw 1.3cqw, #c79b6e; }
  .cork img { position: relative; flex: 0 1 auto; width: auto; height: 78%; min-width: 0; max-width: 21%; object-fit: cover; padding: .25cqw; background: #fffaf2; box-shadow: 0 .3cqw .5cqw rgba(40,15,10,.5); }
  .cork img:nth-child(odd) { transform: rotate(-4deg); }
  .cork img:nth-child(even) { transform: rotate(3deg) translateY(.5cqw); }
  .snaps { width: min(820px, calc(100vw - 32px)); max-height: calc(100vh - 40px); padding: 0; border: 0; color: #fff; background: transparent; }
  .snaps::backdrop { background: rgba(10,4,20,.76); backdrop-filter: blur(4px); }
  .snapgrid { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; padding: 8px; }
  .snapgrid figure { margin: 0; padding: 8px 8px 22px; background: #fffaf2; box-shadow: 0 10px 24px rgba(0,0,0,.55); }
  .snapgrid figure:nth-child(odd) { transform: rotate(-1.500deg); }
  .snapgrid figure:nth-child(even) { transform: rotate(1.500deg); }
  .snapgrid img { display: block; width: auto; height: min(240px, 34vh); max-width: 100%; }
  .snaps form { text-align: center; margin-top: .6rem; }
  .snaps form button { font: inherit; font-size: .9rem; color: #fff; background: none; border: 0; padding: .4rem; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }

  /* desk, seen from across the room */
  .deskback { left: 0; right: 0; top: 62%; height: 38%; background: linear-gradient(#1b0f24, #08040d); }
  .desk { left: 0; right: 0; top: 60%; height: 31%; clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%); background: linear-gradient(180deg, #4a3f5a, #6d5f79 55%, #8a7a8f); }
  .stage::after { content: ''; position: absolute; left: 0; right: 0; top: 91%; height: 2.2%; background: linear-gradient(#5a4b63, #2c2233); z-index: 1; pointer-events: none; }
  .pool { z-index: 2; left: 2%; top: 44%; width: 92%; height: 46%; background: radial-gradient(52% 50% at 42% 62%, rgba(255,214,150,.72), rgba(255,190,110,.32) 45%, transparent 72%); mix-blend-mode: screen; pointer-events: none; transition: opacity .35s; }

  /* monitors */
  .mon { z-index: 2; display: block; padding: .55cqw; border: 0; background: linear-gradient(160deg, #e9e4f3, #a79fb9); border-radius: 1cqw; box-shadow: 0 1.2cqw 2cqw rgba(0,0,0,.55); cursor: pointer; }
  .mon::after { content: ''; position: absolute; left: 44%; right: 44%; top: 100%; height: 2.4cqw; background: linear-gradient(90deg, #8f879f, #d6d0e1, #8f879f); }
  .scr { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; background: #08040f; border-radius: .5cqw; }
  .scr > video, .scr > canvas, .scr > svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .m-up { left: 25%; top: 21%; width: 21%; height: 11%; }
  .m-up::after { display: none; }
  .m-cym { left: 18%; top: 33%; width: 33%; height: 22%; }
  .m-lab { left: 53%; top: 36%; width: 25%; height: 19%; }
  .m-wall { left: 80%; top: 28%; width: 13%; height: 27%; }
  .m-live { left: 57%; top: 22%; width: 18%; height: 11%; }
  .m-live::after { display: none; }
  .swirl { background: conic-gradient(from 0deg, #ff7ab8, #ffd6a8, #7fe7ff, #b6a8ff, #d8ff3e, #ff7ab8); }
  .swirl::after { content: ''; position: absolute; inset: 22%; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, #ffc4e0 30%, #ff5fb0 70%, #8f1e70); box-shadow: 0 0 3cqw #fff8; }
  .tag { background: linear-gradient(#332a3e 1px, transparent 1px) 0 0 / 100% 12%, #211a2b; }
  .eq { display: flex; align-items: flex-end; gap: 6%; padding: 7% 8%; background: #0c0519; }
  .eq i { flex: 1; height: 40%; background: linear-gradient(0deg, #d8ff3e, #22e6ff 60%, #ff4fa8); transform-origin: bottom; animation: eq 1.1s ease-in-out infinite alternate; }
  .eq i:nth-child(2) { height: 70%; animation-delay: -.3s; } .eq i:nth-child(3) { height: 55%; animation-delay: -.7s; } .eq i:nth-child(4) { height: 90%; animation-delay: -.15s; } .eq i:nth-child(5) { height: 50%; animation-delay: -.9s; } .eq i:nth-child(6) { height: 75%; animation-delay: -.5s; }
  @keyframes eq { from { transform: scaleY(.3); } to { transform: scaleY(1); } }

  /* lamp */
  .lamp { z-index: 3; left: 2.5%; top: 31%; width: 13%; height: 33%; padding: 0; border: 0; background: none; cursor: pointer; filter: drop-shadow(0 0 3.4cqw rgba(255,200,120,.95)); transition: filter .35s; }
  .lamp svg { display: block; width: 100%; height: 100%; }
  .stage.dark .lamp { filter: brightness(.42); }
  .stage.dark .pool { opacity: 0; }
  .stage.dark .minikb { filter: brightness(.45) saturate(.75); }
  .stage.dark .minitrays { filter: brightness(.5); }

  /* the same board you play with in the sidebar, in perspective */
  .books { z-index: 3; left: 10%; top: 58%; width: 14.4%; height: auto; transform: rotate(-3deg); transform-origin: 50% 100%; filter: drop-shadow(.8cqw 1cqw 1cqw rgba(30,10,40,.6)); pointer-events: none; transition: filter .35s; }
  .stage.dark .books { filter: brightness(.5) drop-shadow(.8cqw 1cqw 1cqw rgba(30,10,40,.6)); }
  .minikb { z-index: 3; left: 15.5%; top: 63%; width: 50%; padding: 0; border: 0; background: none; cursor: pointer; perspective: 60cqw; transition: filter .35s; }
  .kbcase { display: block; padding: 1%; background: linear-gradient(150deg, #fdfbff, #e7e4f2); border-radius: .7cqw; transform: rotateX(48deg); transform-origin: 50% 100%; box-shadow: 0 2.2cqw 2.2cqw -1cqw rgba(0,0,0,.7); }
  .kbcase :global(.mr) { display: flex; height: 3.3cqw; }
  .kbcase :global(.mk) { flex: var(--w) 0 0; padding: .12cqw; }
  .kbcase :global(.mk > b) { display: block; width: 100%; height: 100%; border-radius: .28cqw; background-size: cover; box-shadow: inset 0 -.3cqw 0 rgba(0,0,0,.2), inset 0 .12cqw 0 rgba(255,255,255,.5); }
  .kbcase :global(.mk.none) { background: #3a3a40; }
  .kbcase :global(.mk.none > b) { background: none !important; box-shadow: none; }

  .minitrays { z-index: 3; left: 24%; top: 79.5%; width: 40%; display: grid; grid-template-columns: 1fr 1fr 1.6fr 1fr; gap: 2%; transition: filter .35s; }
  .minitrays :global(.mt) { display: flex; flex-wrap: wrap; align-content: center; justify-content: center; gap: .25cqw; min-height: 4cqw; padding: .4cqw; border-radius: 50%; background: radial-gradient(circle at 40% 30%, #fff, #ffd5e7 70%, #e39ec1); box-shadow: 0 .7cqw 1cqw rgba(0,0,0,.55); }
  .minitrays :global(.mt.flat) { border-radius: .8cqw; background: linear-gradient(150deg, #fbfbff, #bcc0cf 60%, #eceef6); }
  .minitrays :global(.mt > b) { width: 1.3cqw; height: 1.3cqw; border-radius: .25cqw; background-size: cover; }

  /* notebook */
  .book { z-index: 3; left: 3%; top: 73%; width: 19%; height: 15%; padding: 0; border: 0; background: none; cursor: pointer; perspective: 40cqw; }
  .cover { display: block; width: 100%; height: 100%; border-radius: .4cqw; background: linear-gradient(90deg, #d7cdb8 0 5%, #f3ecdc 6% 100%); box-shadow: 0 1cqw 1.4cqw rgba(0,0,0,.6), inset 0 0 0 .15cqw #e2d9c5; transform: rotateX(46deg) rotateZ(-7deg); position: relative; transition: transform .2s; }
  .cover::after { content: ''; position: absolute; left: 58%; bottom: -14%; width: 4%; height: 22%; background: #ff7ab8; }
  .book:hover .cover { transform: rotateX(40deg) rotateZ(-7deg) translateY(-.8cqw); }

  /* pour-over */
  .pour { z-index: 4; left: 65.5%; top: 49%; width: 34%; aspect-ratio: 336/290; }
  .pour svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .pour :global(.hit), .pour :global(.kettle) { cursor: pointer; outline: none; }
  .pour :global(.kettle) { touch-action: none; transform-box: view-box; transform-origin: 49px 240px; transition: transform .45s cubic-bezier(.3,.9,.3,1); }
  .pour :global(.kettle:focus-visible path), .pour :global(.hit:focus-visible path) { stroke: #fff; stroke-width: 4; }
  .pour :global(.pouring) { transform: translate(7px, -102px) rotate(30deg); }
  .steam { animation: steam 3s ease-in-out infinite; }
  @keyframes steam { 50% { transform: translateY(-5px); } }

  .said { margin: .7rem 0 .25rem; min-height: 1.5em; font-size: .86rem; color: var(--ink); }
  .rooms { display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .84rem; }

  /* the open notebook */
  .spread { width: min(760px, calc(100vw - 32px)); padding: 0; border: 0; color: #362a22; background: transparent; }
  .spread::backdrop { background: rgba(10,4,20,.72); backdrop-filter: blur(4px); }
  .pages { display: grid; grid-template-columns: 1fr 1fr; min-height: min(60vh, 460px); border-radius: 8px; overflow: hidden; background-color: #fbf7ec; background-image: linear-gradient(rgba(140,160,170,.28) 1px, transparent 1px), linear-gradient(90deg, rgba(140,160,170,.28) 1px, transparent 1px); background-size: 18px 18px; box-shadow: 0 20px 50px rgba(0,0,0,.6); }
  .page { padding: 1.6rem 1.5rem; }
  .left { box-shadow: inset -14px 0 18px -14px rgba(90,60,30,.5); }
  .right { box-shadow: inset 14px 0 18px -14px rgba(90,60,30,.5); }
  .page h2 { margin: 0 0 .9rem; font: 900 1.5rem/1.1 'Zen Maru Gothic', sans-serif; color: #362a22; }
  .page ul { margin: 0; padding: 0; list-style: none; }
  .page li { display: flex; flex-direction: column; margin-bottom: .9rem; }
  .page a { color: #c21e78; font-weight: 700; font-size: 1.05rem; }
  .page time { font-size: .78rem; color: #7c6c5e; }
  .spread form { text-align: center; margin-top: .7rem; }
  .spread form button { font: inherit; font-size: .9rem; color: #fff; background: none; border: 0; padding: .4rem; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 560px) { .pages { grid-template-columns: 1fr; } .right { display: none; } }

  @media (prefers-reduced-motion: reduce) { .enter, .eq i, .steam { animation: none; } .pour :global(.kettle) { transition: none; } }
</style>

<script>
  const scene = document.querySelector('[data-scene]') as HTMLElement;
  const stage = scene.querySelector('[data-stage]') as HTMLElement;
  const said = scene.querySelector('[data-said]') as HTMLElement;
  const q = <T extends Element>(s: string) => scene.querySelector(s) as T;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let onScreen = true;
  new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; if (onScreen) wake(); }).observe(stage);

  /* lamp */
  const lamp = q<HTMLElement>('[data-lamp]');
  lamp.addEventListener('click', () => {
    const dark = stage.classList.toggle('dark');
    lamp.setAttribute('aria-pressed', String(!dark));
  });

  /* notebook */
  const spread = q<HTMLDialogElement>('[data-spread]');
  q('[data-book]').addEventListener('click', () => spread.showModal());
  spread.addEventListener('click', (e) => { if (e.target === spread) spread.close(); });

  /* bulletin board */
  const snaps = q<HTMLDialogElement>('[data-snaps]');
  q('[data-pins]').addEventListener('click', () => { snaps.showModal(); snaps.scrollTop = 0; });
  snaps.addEventListener('click', (e) => { if (e.target === snaps) snaps.close(); });

  /* far-away keyboard and trays mirror the real ones in the sidebar */
  const mini = q<HTMLElement>('[data-mini]'), miniTrays = q<HTMLElement>('[data-minitrays]');
  const capStyle = (cap: Element | null) => {
    const top = cap?.querySelector('.top');
    return top ? getComputedStyle(top).background : '';
  };
  let mirrorQueued = false;
  function mirror() {
    mirrorQueued = false;
    const kb = document.querySelector('keycap-board');
    if (!kb) return;
    mini.replaceChildren(...[...kb.querySelectorAll('.row')].map((row) => {
      const r = document.createElement('span'); r.className = 'mr'; r.style.display = 'flex';
      for (const el of row.children) {
        const k = document.createElement('span'); k.className = 'mk';
        k.style.setProperty('--w', (el as HTMLElement).style.getPropertyValue('--w'));
        const b = document.createElement('b');
        if (el.classList.contains('socket')) {
          const cap = el.querySelector('.cap');
          if (cap) b.style.background = capStyle(cap); else k.classList.add('none');
        } else b.style.background = 'none';
        k.append(b); r.append(k);
      }
      return r;
    }));
    miniTrays.replaceChildren(...[...kb.querySelectorAll('[data-tray]')].map((t) => {
      const m = document.createElement('span'); m.className = 'mt' + (t.classList.contains('platter') ? ' flat' : '');
      for (const c of t.querySelectorAll('.cap')) { const b = document.createElement('b'); b.style.background = capStyle(c); m.append(b); }
      return m;
    }));
  }
  const queueMirror = () => { if (!mirrorQueued) { mirrorQueued = true; requestAnimationFrame(mirror); } };
  customElements.whenDefined('keycap-board').then(() => {
    const kb = document.querySelector('keycap-board');
    if (!kb) return;
    new MutationObserver(queueMirror).observe(kb, { childList: true, subtree: true });
    mirror();
    addEventListener('load', mirror, { once: true });
  });
  q('[data-minikb]').addEventListener('click', () => {
    document.querySelector('keycap-board')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
  });

  /* pour-over: hold the kettle, water drains through the grounds into the carafe */
  const kettle = q<SVGGElement>('[data-kettle]'), streamEl = q<SVGPathElement>('[data-stream]'), waterEl = q<SVGRectElement>('[data-water]');
  const coffeeEl = q<SVGRectElement>('[data-coffee]'), dropEl = q<SVGCircleElement>('[data-drop]'), cupEl = q<SVGRectElement>('[data-cupfill]');
  const steamEl = q<SVGPathElement>('[data-steam]'), grounds = q<SVGEllipseElement>('[data-grounds]');
  let pouring = false, water = 0, coffee = 0, cup = 0, bloomed = false, pourStart = 0, told = '';
  const tell = (s: string) => { if (s !== told) { told = s; said.textContent = s; } };
  const startPour = () => {
    if (pouring) return;
    if (coffee >= .98) { tell('The carafe is full. Tap it to pour a cup.'); return; }
    pouring = true; pourStart = performance.now(); kettle.classList.add('pouring'); wake();
  };
  const stopPour = () => { if (!pouring) return; pouring = false; kettle.classList.remove('pouring'); streamEl.setAttribute('opacity', '0'); wake(); };
  kettle.addEventListener('pointerdown', (e) => { e.preventDefault(); kettle.setPointerCapture(e.pointerId); startPour(); });
  kettle.addEventListener('pointerup', stopPour);
  kettle.addEventListener('pointercancel', stopPour);
  kettle.addEventListener('lostpointercapture', stopPour);
  kettle.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });
  kettle.addEventListener('keydown', (e) => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) { e.preventDefault(); startPour(); } });
  kettle.addEventListener('keyup', (e) => { if (e.key === ' ' || e.key === 'Enter') stopPour(); });
  kettle.addEventListener('blur', stopPour);
  const activate = (el: Element, fn: () => void) => { el.addEventListener('click', fn); el.addEventListener('keydown', (e) => { const k = (e as KeyboardEvent).key; if (k === ' ' || k === 'Enter') { e.preventDefault(); fn(); } }); };
  activate(q('[data-carafe]'), () => {
    if (coffee < .15) { tell('The carafe is empty. Hold the kettle to brew.'); return; }
    if (cup > .95) { tell('The cup is full. Tap it to take a sip.'); return; }
    const move = Math.min(coffee, Math.max(0, 1 - cup) * .5);
    coffee -= move; cup = Math.min(1, cup + move * 2);
    tell('Poured. Tap the cup to take a sip.'); wake();
  });
  activate(q('[data-cup]'), () => {
    if (cup <= 0) { tell(coffee > .15 ? 'Tap the carafe to pour a cup.' : 'Nothing in the cup yet.'); return; }
    cup = Math.max(0, cup - .25);
    if (cup === 0) { tell(coffee > .15 ? 'All gone. There’s more in the carafe.' : 'All gone. Hold the kettle to make more.'); if (coffee <= .15) { coffee = 0; bloomed = false; } }
    else tell('Mmm.');
    wake();
  });
  function drawPour(now: number) {
    if (pouring && now - pourStart > 380) { streamEl.setAttribute('opacity', '1'); water = Math.min(1, water + .0075); }
    if (water >= 1 && pouring) { stopPour(); tell('Let it drain, then pour again.'); }
    if (water > 0) {
      const d = Math.min(water, .0032); water -= d; coffee = Math.min(1, coffee + d * .62);
      if (!bloomed && water > .1) { bloomed = true; tell('The grounds are blooming. Keep pouring.'); }
    }
    if (coffee >= .98) { tell('Coffee’s ready. Tap the carafe to pour a cup.'); if (pouring) stopPour(); }
    const wh = water * 44; waterEl.setAttribute('y', String(170 - wh)); waterEl.setAttribute('height', String(wh));
    const ch = coffee * 92; coffeeEl.setAttribute('y', String(288 - ch)); coffeeEl.setAttribute('height', String(ch));
    const uh = cup * 70; cupEl.setAttribute('y', String(292 - uh)); cupEl.setAttribute('height', String(uh));
    grounds.setAttribute('ry', String(bloomed ? 13 : 9)); grounds.setAttribute('cy', String(bloomed ? 150 : 156));
    steamEl.setAttribute('opacity', cup > 0 ? '.75' : '0');
    if (water > 0) { const t = (now / 520) % 1; dropEl.setAttribute('cy', String(190 + t * (276 - ch - 190))); dropEl.setAttribute('opacity', String(t < .95 ? 1 : 0)); }
    else dropEl.setAttribute('opacity', '0');
  }

  /* the cymatic monitor */
  const cv = q<HTMLCanvasElement>('[data-cym]'), cg = cv.getContext('2d')!, img = cg.createImageData(cv.width, cv.height);
  let lastCym = 0;
  function drawCym(now: number) {
    if (now - lastCym < 90) return;
    lastCym = now;
    const w = cv.width, h = cv.height, s = now / 5000, n = 3 + Math.sin(s) * 1.6, m = 5 + Math.cos(s * .7) * 2;
    for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
      const u = (x / w) * Math.PI, v = (y / h) * Math.PI;
      const a = Math.abs(Math.cos(n * u) * Math.cos(m * v) - Math.cos(m * u) * Math.cos(n * v));
      const l = Math.max(0, 1 - a * 3.4), i = (y * w + x) * 4;
      img.data[i] = 18 + 237 * l; img.data[i + 1] = 8 + 150 * l * l; img.data[i + 2] = 40 + 195 * l; img.data[i + 3] = 255;
    }
    cg.putImageData(img, 0, 0);
  }

  let looping = false;
  function loop(now: number) {
    if (!onScreen || document.hidden) { looping = false; return; }
    drawPour(now);
    if (!reduce) drawCym(now);
    if (reduce && !pouring && water <= 0) { looping = false; return; }
    requestAnimationFrame(loop);
  }
  function wake() { if (!looping) { looping = true; requestAnimationFrame(loop); } }
  document.addEventListener('visibilitychange', wake);
  drawCym(1e4);
  wake();
</script>

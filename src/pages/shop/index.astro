---
import Base from '../../layouts/Base.astro';
---
<Base title="Shop — Koala Walla Land" description="Closed for now. New keycaps coming soon.">
  <h1>Shop</h1>
  <div class="window">
    <div class="charms" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((i) => (
        <span class="charm" style={`--i:${i}`}><svg viewBox="0 0 40 56"><path d="M15 26c-5-9-5-21-1-22s6 10 6 18c0-8 3-19 7-18s3 13-2 22c5 3 8 8 8 13 0 8-7 13-15 13S3 47 3 39c0-5 5-10 12-13Z" /><circle cx="14" cy="37" r="1.8" fill="#16131b" /><circle cx="25" cy="37" r="1.8" fill="#16131b" /></svg></span>
      ))}
    </div>
    <p class="sign">CLOSED <small>back soon ♡</small></p>
    <div class="caps" aria-hidden="true">{[0, 1, 2, 3].map(() => <span class="sil"></span>)}</div>
  </div>
  <p class="meta">Upcoming keycaps are in the back. The door opens soon.</p>
  <p><a href="/">&larr; back to Koala Walla Land</a></p>
</Base>

<style>
  .window { position: relative; min-height: 22rem; margin-top: 1rem; overflow: hidden; border: 6px solid #aab1d6; border-radius: 16px 16px 6px 6px; background: linear-gradient(170deg, #2f2748, #16131b 75%); box-shadow: inset 0 0 50px rgba(88,216,245,.18), 0 0 26px rgba(170,177,214,.25); }
  .charms { display: flex; justify-content: space-around; padding: 0 1rem; }
  .charm { display: block; width: 40px; padding-top: calc(18px + var(--i) * 9px); border-left: 0; background: linear-gradient(#cdd2ee, #cdd2ee) center top / 1px calc(18px + var(--i) * 9px) no-repeat; transform-origin: top center; animation: sway calc(3s + var(--i) * .4s) ease-in-out infinite alternate; }
  .charm svg { display: block; fill: #ffc8e4; }
  @keyframes sway { from { transform: rotate(-5deg); } to { transform: rotate(5deg); } }
  .sign { position: absolute; left: 50%; top: 42%; margin: 0; padding: .5rem 1.1rem; color: #16131b; background: #f6ede2; border-radius: 6px; font-family: var(--font-display); font-size: 1.6rem; line-height: 1.1; text-align: center; transform: translate(-50%, -50%) rotate(-3deg); }
  .sign small { display: block; font: .75rem var(--font-mono); }
  .caps { position: absolute; left: 0; right: 0; bottom: 1.4rem; display: flex; justify-content: center; gap: 1rem; }
  .sil { width: 56px; height: 50px; background: #0c0a12; border-radius: 12px 12px 8px 8px; box-shadow: 0 0 12px rgba(255,122,184,.35); }
  @media (prefers-reduced-motion: reduce) { .charm { animation: none; } }
</style>

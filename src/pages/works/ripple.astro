---
import Base from '../../layouts/Base.astro';

// This page is the template for interactive works: a Base layout for
// nav consistency, then raw canvas + script with nothing in the way.
// Three.js, WebGL, audio — anything goes here. To go truly full-bleed,
// skip Base entirely and write a plain <html> page.
---
<Base title="Ripple tank — koalawallaland">
  <h1>Ripple tank</h1>
  <p class="meta">Click or drag to move a source. Scroll on the canvas to change frequency.</p>

  <canvas id="tank" width="800" height="500" style="width:100%; border:1px solid var(--line); touch-action:none;"></canvas>

  <script>
    const c = document.getElementById('tank') as HTMLCanvasElement;
    const ctx = c.getContext('2d')!;
    const W = c.width, H = c.height;

    const sources = [
      { x: W * 0.35, y: H * 0.5 },
      { x: W * 0.65, y: H * 0.5 },
    ];
    let k = 0.11;      // spatial frequency
    let t = 0;
    let held: number | null = null;

    function canvasPos(e: PointerEvent) {
      const r = c.getBoundingClientRect();
      return {
        x: ((e.clientX - r.left) / r.width) * W,
        y: ((e.clientY - r.top) / r.height) * H,
      };
    }

    c.addEventListener('pointerdown', (e) => {
      const p = canvasPos(e);
      // grab the nearest source
      held = sources[0] && Math.hypot(p.x - sources[0].x, p.y - sources[0].y) <
             Math.hypot(p.x - sources[1].x, p.y - sources[1].y) ? 0 : 1;
      sources[held] = p;
      c.setPointerCapture(e.pointerId);
    });
    c.addEventListener('pointermove', (e) => {
      if (held !== null) sources[held] = canvasPos(e);
    });
    c.addEventListener('pointerup', () => { held = null; });
    c.addEventListener('wheel', (e) => {
      e.preventDefault();
      k = Math.min(0.35, Math.max(0.03, k + (e.deltaY > 0 ? -0.008 : 0.008)));
    }, { passive: false });

    const img = ctx.createImageData(W, H);
    const d = img.data;

    function frame() {
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          let v = 0;
          for (const s of sources) {
            v += Math.sin(Math.hypot(x - s.x, y - s.y) * k - t);
          }
          // map [-2, 2] -> brightness, pink on ink
          const b = (v + 2) / 4;
          const i = (y * W + x) * 4;
          d[i]     = 22 + b * 233;  // r
          d[i + 1] = 19 + b * 103;  // g
          d[i + 2] = 27 + b * 157;  // b
          d[i + 3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
      t += 0.12;
      requestAnimationFrame(frame);
    }
    frame();
  </script>

  <hr />
  <p><a href="/works/">&larr; all works</a></p>
</Base>

      <svg class="lamp l-ada" viewBox="0 0 70 110" role="img" aria-label="Ada, a matte white lamp with a smooth shade"><!-- Ada: smooth broad shallow cone, small cap, straight matte white stem -->
        <defs><linearGradient id="adaMatte" x1="0" x2="1"><stop offset="0" stop-color="#cfc9c4"/><stop offset=".4" stop-color="#f4f0ea"/><stop offset="1" stop-color="#bdb6b0"/></linearGradient></defs>
        <rect x="29" y="2" width="12" height="9" rx="1" fill="url(#adaMatte)"/>
        <path d="M26 11h18L66 40H4z" fill="url(#adaMatte)"/>
        <rect x="27" y="40" width="16" height="68" fill="url(#adaMatte)"/>
      </svg>
      <svg class="lamp l-lav" viewBox="0 0 70 110" aria-hidden="true"><!-- lavender pleated cone, slender brass frame, open square base -->
        <path d="M35 4L66 42H4z" fill="#c9a8ee"/>
        <path d="M35 4L9 42M35 4L16 42M35 4L23 42M35 4L30 42M35 4L37 42M35 4L44 42M35 4L51 42M35 4L58 42" stroke="#8d68bd" stroke-width=".9"/>
        <path d="M35 42V94M35 94L15 104M35 94L55 104M15 104H55" fill="none" stroke="#d4ad58" stroke-width="2"/>
      </svg>


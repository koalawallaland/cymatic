        <circle cx="52.800" cy="124" r=".8" fill="#d27d9f"/><circle cx="57.200" cy="124" r=".8" fill="#d27d9f"/>
        <!-- wide open mouth with soft bumps -->
        <path d="M44 128q11 4 22 0q-1 7-11 7.500q-10-.5-11-7.500z" fill="#d27d9f"/>
        <path d="M46 129q9 3 18 0q-.5 1.800-1 2.300q-8 2.200-16 0z" fill="#fde3ec"/>
        <path d="M47 135q8 4 16 0" fill="none" stroke="#eda3bf" stroke-width="1"/>
        <circle cx="48" cy="137" r="1.500" fill="#f9c6d8" stroke="#eda3bf" stroke-width=".5"/><circle cx="62" cy="137" r="1.500" fill="#f9c6d8" stroke="#eda3bf" stroke-width=".5"/>

---
import Base from '../../layouts/Base.astro';
import KeycapBoard from '../../components/KeycapBoard.astro';
import Cymatics from '../../components/Cymatics.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base title="koalawallaland">
  
  <section class="opening">
    <h1 class="modak">Koala Walla Land</h1>
    <p class="prompt">Pull caps off, swap them, or type. The flickering sign opens the lab.</p>

    <div class="band">
      <a class="pane brick" href="/wall/" aria-label="Graffiti wall">
        <svg viewBox="0 0 100 180" aria-hidden="true"><path d="M8 62q14-48 28-12q11 24 23-20q8-22 30 5" fill="none" stroke="#ff7ab8" stroke-width="7" stroke-linecap="round"/><path d="M10 96q24-13 76-5" fill="none" stroke="#58d8f5" stroke-width="5" stroke-linecap="round"/><path d="M18 130c9-15 22 3 12 11c-10-8 3-26 12-11M56 118l10 22l10-22" fill="none" stroke="#d8ff3e" stroke-width="4.500" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="pane" href="/lab/" aria-label="Shoji screen: the resin lab" tabindex="-1"></a>
      <a class="pane" href="/lab/" aria-label="Shoji screen: the resin lab" tabindex="-1"></a>
      <a class="pane third" href="/lab/" aria-label="Shoji screen: the resin lab" tabindex="-1"></a>

      <p class="neon vert" style="--n:#ff2f9e;left:27%;top:7%" aria-hidden="true">樹脂</p>
      <p class="neon" style="--n:#c6ff00;left:49%;top:7%;font-size:clamp(20px,5.4vw,30px)" aria-hidden="true">猫</p>
      <p class="neon vert small" style="--n:#22e6ff;right:3%;top:6%" aria-hidden="true">キーキャップ</p>
      <a class="neon enter" href="/lab/" aria-label="Enter the lab to do a cast" style="--n:#ff4a3d"><span>入口 ENTER</span><small>THE LAB</small></a>
      <a class="shopsign" href="/shop/" aria-label="Shop, closed for now">SHOP<small>closed ♡</small></a>


      <!-- her lamps, drawn from the product images and room photos she shared -->
      <div class="pool" style="left:22%;--c:rgba(255,196,120,.5)" aria-hidden="true"></div>
      <div class="pool" style="left:81%;--c:rgba(255,190,110,.62)" aria-hidden="true"></div>
      <svg class="lamp lit l-del" viewBox="0 0 60 120" role="img" aria-label="Delilah, a lamp with a fluted ivory shade"><!-- Delilah: tall fluted ivory shade, glossy tapered base -->
        <defs><linearGradient id="ivoryGlow" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff2cf"/><stop offset="1" stop-color="#ffc877"/></linearGradient><linearGradient id="gloss" x1="0" x2="1"><stop offset="0" stop-color="#d8d3cc"/><stop offset=".3" stop-color="#fff"/><stop offset="1" stop-color="#bdb6b0"/></linearGradient></defs>
        <rect x="10" y="3" width="40" height="52" rx="2" fill="url(#ivoryGlow)"/>
        <path d="M14 3v52M18 3v52M22 3v52M26 3v52M30 3v52M34 3v52M38 3v52M42 3v52M46 3v52" stroke="#d99c55" stroke-width=".8" opacity=".55"/>
        <path d="M26 55h8q1 16 5 30q6 18 3 32H18q-3-14 3-32q4-14 5-30z" fill="url(#gloss)"/>
      </svg>
      <svg class="lamp lit l-foo" viewBox="0 0 110 196" role="img" aria-label="Pink foo dog table lamp with a wide white drum shade"><!-- foo dog lamp, glossy single-glaze ceramic -->
        <defs>
          <linearGradient id="fooG" gradientUnits="userSpaceOnUse" x1="30" y1="100" x2="80" y2="196"><stop offset="0" stop-color="#fde3ec"/><stop offset=".5" stop-color="#f9c6d8"/><stop offset="1" stop-color="#f0abc5"/></linearGradient>
          <linearGradient id="fooShade" x1="0" x2="1"><stop offset="0" stop-color="#eee6dc"/><stop offset=".3" stop-color="#fffdf7"/><stop offset=".7" stop-color="#fffaf0"/><stop offset="1" stop-color="#e9dfd2"/></linearGradient>
        </defs>
        <rect x="50.500" y="0" width="9" height="11" rx="1" fill="url(#fooG)"/><path d="M52 3.500q3 1.500 6 0M52 6.500q3 1.500 6 0" fill="none" stroke="#eda3bf" stroke-width=".6"/>
        <path d="M2 11q0-2 2-2h102q2 0 2 2v82q0 2-2 2H4q-2 0-2-2z" fill="url(#fooShade)"/>
        <path d="M2 14.500h106M2 90h106" stroke="#d8cfc3" stroke-width=".7"/>
        <rect x="52.500" y="95" width="5" height="12" fill="url(#fooG)"/>
        <!-- pedestal -->
        <path d="M37 183h36l5 9v4H32v-4z" fill="url(#fooG)"/><path d="M32 192h46" stroke="#eda3bf" stroke-width=".7"/>
        <rect x="36" y="172.500" width="38" height="11" fill="url(#fooG)"/>
        <rect x="38.2" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="39.3" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/><rect x="42.7" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="43.8" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/><rect x="47.2" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="48.3" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/><rect x="51.7" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="52.8" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/><rect x="56.2" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="57.3" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/><rect x="60.7" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="61.8" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/><rect x="65.2" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="66.3" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/><rect x="69.7" y="175.500" width="3.800" height="5" rx="1.500" fill="#d27d9f"/><rect x="70.8" y="176.900" width="1.600" height="2.200" rx=".6" fill="#eda3bf"/>
        <path d="M31 167h48l2.500 6h-53z" fill="#fde3ec"/><path d="M28.500 173h53" stroke="#eda3bf" stroke-width=".9"/>
        <!-- seated body and haunches -->
        <path d="M43 136q-6 12-7 22q-1 7 2 10h34q3-3 2-10q-1-10-7-22z" fill="url(#fooG)"/>
        <path d="M37 160q-2-9 4-14M73 160q2-9-4-14" fill="none" stroke="#eda3bf" stroke-width=".9"/>
        <!-- chest with collar and tassel -->
        <path d="M46 137q9 7 18 0" fill="none" stroke="#eda3bf" stroke-width="1.300"/>
        <circle cx="55" cy="143" r="2.500" fill="#fde3ec" stroke="#eda3bf" stroke-width=".7"/><path d="M53.200 146h3.600l1 6h-5.600z" fill="#f9c6d8" stroke="#eda3bf" stroke-width=".6"/>
        <!-- ball, then the paw resting on it -->
        <circle cx="66" cy="160.500" r="7.800" fill="url(#fooG)" stroke="#eda3bf" stroke-width=".7"/><path d="M61.500 157.500a5.500 5.500 0 0 1 4-3" fill="none" stroke="#fff" stroke-width="1.200" stroke-linecap="round"/>
        <path d="M60 139q-2 7 0 12q-1 2 0 4h12q2-2 1-4q2-6-1-12z" fill="url(#fooG)"/><path d="M61 141q-1 7 0 11M71 141q2 6 0 11" fill="none" stroke="#eda3bf" stroke-width=".7"/>
        <path d="M63.500 150.500v4M66.500 150.500v4.500M69.500 150.500v4" stroke="#eda3bf" stroke-width=".8"/>
        <!-- planted leg and paw -->
        <path d="M39 141q-2 11 0 20h-1.500q-2 1-2 4v2.500h15V165q0-3-3-4q1-9-.5-20z" fill="url(#fooG)"/><path d="M40.500 145q-1 8 0 15" fill="none" stroke="#eda3bf" stroke-width=".7"/>
        <path d="M39.500 163.500v4M43 163.500v4M46.500 163.500v4" stroke="#eda3bf" stroke-width=".8"/>
        <!-- head -->
        <circle cx="41" cy="113" r="4.6" fill="url(#fooG)"/><path d="M38.7 113.5a2.3 2.3 0 1 1 4.1 1.1" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="47" cy="108" r="4.6" fill="url(#fooG)"/><path d="M44.7 108.5a2.3 2.3 0 1 1 4.1 1.1" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="55" cy="106.5" r="5" fill="url(#fooG)"/><path d="M52.5 107.0a2.5 2.5 0 1 1 4.5 1.2" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="63" cy="108" r="4.6" fill="url(#fooG)"/><path d="M60.7 108.5a2.3 2.3 0 1 1 4.1 1.1" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="69" cy="113" r="4.6" fill="url(#fooG)"/><path d="M66.7 113.5a2.3 2.3 0 1 1 4.1 1.1" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="38.8" cy="120" r="4.2" fill="url(#fooG)"/><path d="M36.7 120.4a2.1 2.1 0 1 1 3.8 1.1" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="71.2" cy="120" r="4.2" fill="url(#fooG)"/><path d="M69.1 120.4a2.1 2.1 0 1 1 3.8 1.1" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="38.8" cy="127" r="3.9" fill="url(#fooG)"/><path d="M36.8 127.4a1.9 1.9 0 1 1 3.5 1.0" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="71.2" cy="127" r="3.9" fill="url(#fooG)"/><path d="M69.2 127.4a1.9 1.9 0 1 1 3.5 1.0" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="41.5" cy="133" r="3.6" fill="url(#fooG)"/><path d="M39.7 133.4a1.8 1.8 0 1 1 3.2 0.9" fill="none" stroke="#eda3bf" stroke-width=".7"/><circle cx="68.5" cy="133" r="3.6" fill="url(#fooG)"/><path d="M66.7 133.4a1.8 1.8 0 1 1 3.2 0.9" fill="none" stroke="#eda3bf" stroke-width=".7"/>
        <path d="M44 112q11-5 22 0q5 6 4.500 15q-.5 8-4 11q-11 4-23 0q-3.500-3-4-11q-.5-9 4.500-15z" fill="url(#fooG)"/>
        <path d="M41 108l-3-6q5 1 7 4zM69 108l3-6q-5 1-7 4z" fill="#f9c6d8"/>
        <!-- brows, eyes, broad nose -->
        <path d="M43 116q5-4 10 0M67 116q-5-4-10 0" fill="none" stroke="#eda3bf" stroke-width="1.700" stroke-linecap="round"/>
        <path d="M45 119.500q3.500-2 7 .5M65 119.500q-3.500-2-7 .5" fill="none" stroke="#d27d9f" stroke-width="1.100" stroke-linecap="round"/>

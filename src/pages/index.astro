        <rect x="6" y="1" width="58" height="33" rx="2" fill="#fbf8f4" stroke="#d9d0c8"/>
        <rect x="30" y="34" width="10" height="9" fill="#f493ba" stroke="#a84373" stroke-width="1"/>
        <g transform="translate(0 40)">
          <g fill="url(#fooGlaze)" stroke="#a84373" stroke-width="1.100" stroke-linejoin="round">
            <path d="M10 110q1-7 7-8h36q6 1 7 8z"/>
            <rect x="15" y="89" width="40" height="13"/>
            <rect x="9" y="84" width="52" height="5" rx="2"/>

---
import Base from '../layouts/Base.astro';
import DeskScene from '../components/DeskScene.astro';
import KeycapBoard from '../components/KeycapBoard.astro';
import ChessBoard from '../components/ChessBoard.astro';
import MahjongTiles from '../components/MahjongTiles.astro';
import KoalaWindow from '../components/KoalaWindow.astro';
import OuijaBoard from '../components/OuijaBoard.astro';
import TarotDeck from '../components/TarotDeck.astro';
import { getCollection } from 'astro:content';

// Paste a public Apple Music playlist link here and the player switches to it.
const APPLE_PLAYLIST = '';
const embed = APPLE_PLAYLIST.replace('https://music.apple.com', 'https://embed.music.apple.com');

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ id: p.id, title: p.data.title, date: p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) }));
---
<Base title="koalawallaland">
  <h1 class="sr">koalawallaland</h1>
  <div class="room">
    <div class="centre"><DeskScene posts={posts} /></div>

    <aside class="side left" aria-label="Window, music and divination">
      <KoalaWindow />
      <div class="pair">
        <section aria-labelledby="h-ig">
          <h2 id="h-ig">Instagram</h2>
          <div class="ig">
            <a href="https://www.instagram.com/koalawallaland/" target="_blank" rel="noopener"><img src="/doodles/round-eye.webp" alt="" /><b>main</b></a>
            <a href="https://www.instagram.com/koalawallaland/reposts/" target="_blank" rel="noopener"><img src="/doodles/wing-b.webp" alt="" /><b>reposts</b></a>
          </div>
        </section>
        <section aria-labelledby="h-mu">
          <h2 id="h-mu">Music</h2>
          {embed ? (
            <iframe class="am" title="Apple Music playlist" src={embed} height="150" loading="lazy" allow="autoplay *; encrypted-media *; fullscreen *" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"></iframe>
          ) : (
            <button type="button" class="player" data-pocket>
              <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>Play the beat pocket</span>
            </button>
            <a class="amlink" href="https://music.apple.com/profile/koalawallaland" target="_blank" rel="noopener">Apple Music</a>
          )}
        </section>
      </div>
      <section aria-labelledby="h-ou">
        <h2 id="h-ou">Talking board</h2>
        <div style="--tb-gap:0"><OuijaBoard lines={['KOALAWALLALAND', 'CRYNET', 'LOW ONE STAYS', 'SHE FINDS ME STILL']} /></div>
      </section>
      <section aria-labelledby="h-ta">
        <h2 id="h-ta">Tarot</h2>
        <TarotDeck />
      </section>
    </aside>

    <aside class="side right" aria-label="Keyboard and games">
      <section aria-labelledby="h-kb">
        <h2 id="h-kb" class="sr">Keyboard and trays</h2>
        <KeycapBoard />
      </section>
      <section id="chess" aria-labelledby="h-ch">
        <h2 id="h-ch">Chess</h2>
        <ChessBoard />
      </section>
      <section aria-labelledby="h-mj">
        <h2 id="h-mj">Mahjong</h2>
        <MahjongTiles />
      </section>
    </aside>
  </div>
</Base>

<style is:global>
  main { max-width: none; padding: .75rem clamp(16px, 2vw, 28px) 4rem; }
</style>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .room { display: grid; gap: 2.4rem; grid-template-columns: minmax(0, 1fr); grid-template-areas: 'centre' 'right' 'left'; }
  .centre { grid-area: centre; min-width: 0; }
  .left { grid-area: left; } .right { grid-area: right; }
  .side { display: flex; flex-direction: column; gap: 2.4rem; min-width: 0; }
  @media (min-width: 760px) {
    .room { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); grid-template-areas: 'centre centre' 'left right'; }
    .centre :global(.scene) { max-width: min(100%, 72vh); margin-inline: auto; }
  }
  @media (min-width: 1180px) {
    .room { grid-template-columns: minmax(270px, 310px) minmax(0, 1fr) minmax(400px, 470px); grid-template-areas: 'left centre right'; align-items: start; }
    .centre { position: sticky; top: .75rem; }
    .centre :global(.scene) { max-width: min(100%, 72vh); }
  }
  h2 { margin: 0 0 .65rem; font: 900 1.05rem/1.2 'Zen Maru Gothic', 'Hiragino Maru Gothic ProN', sans-serif; letter-spacing: 0; color: #ffd3e8; text-shadow: 0 0 10px rgba(255,79,168,.6); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ig { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem; }
  .ig a { display: flex; flex-direction: column; align-items: center; gap: .2rem; padding: .45rem .15rem; color: #27341a; background: linear-gradient(150deg, #fffdf6, #f6e6ee); border-radius: 10px; text-decoration: none; font-size: .72rem; }
  .ig img { width: 32px; height: 32px; object-fit: contain; }
  .player { display: flex; width: 100%; min-height: 66px; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; padding: .4rem; font: inherit; font-size: .74rem; line-height: 1.2; color: #fff; background: linear-gradient(160deg, #3b1d66, #1a0d33); border: 1px solid rgba(255,245,251,.3); border-radius: 12px; cursor: pointer; }
  .player:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .player .eq { display: flex; align-items: flex-end; gap: 3px; height: 20px; }
  .player .eq i { width: 5px; height: 100%; background: linear-gradient(0deg, #d8ff3e, #ff4fa8); transform-origin: bottom; animation: peq 1s ease-in-out infinite alternate; }
  .player .eq i:nth-child(2) { animation-delay: -.4s; } .player .eq i:nth-child(3) { animation-delay: -.7s; }
  @keyframes peq { from { transform: scaleY(.25); } to { transform: scaleY(1); } }
  .amlink { display: block; margin-top: .35rem; font-size: .76rem; text-align: center; }
  .am { display: block; width: 100%; border: 0; border-radius: 12px; overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .player .eq i { animation: none; } }
</style>

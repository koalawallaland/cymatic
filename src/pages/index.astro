---
import Base from '../layouts/Base.astro';
import KeycapBoard from '../components/KeycapBoard.astro';
import Cymatics from '../components/Cymatics.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<Base title="koalawallaland">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Modak&family=Zen+Maru+Gothic:wght@700;900&display=swap" />
  <div class="rainy" aria-hidden="true"></div>
  <section class="opening">
    <h1 class="modak">Koala Walla Land</h1>
    <p class="prompt">Pull caps off, swap them, or type. The flickering sign opens the lab.</p>

    <div class="band">
      <a class="pane brick" href="/wall/" aria-label="Graffiti wall">
        <svg viewBox="0 0 100 180" aria-hidden="true"><path d="M8 62q14-48 28-12q11 24 23-20q8-22 30 5" fill="none" stroke="#ff7ab8" stroke-width="7" stroke-linecap="round"/><path d="M10 96q24-13 76-5" fill="none" stroke="#58d8f5" stroke-width="5" stroke-linecap="round"/><path d="M18 130c9-15 22 3 12 11c-10-8 3-26 12-11M56 118l10 22l10-22" fill="none" stroke="#d8ff3e" stroke-width="4.500" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="pane" href="/lab/" aria-label="Shoji screen: the resin lab" tabindex="-1"></a>
      <a class="pane" href="/lab/" aria-label="Shoji screen: the resin lab" tabindex="-1"></a>
      <a class="pane third" href="/lab/" aria-label="Shoji screen: the resin lab" tabindex="-1"></a>

      <p class="neon vert" style="--n:#ff2f9e;left:27%;top:7%" aria-hidden="true">樹脂</p>
      <p class="neon" style="--n:#c6ff00;left:49%;top:7%;font-size:clamp(20px,5.4vw,30px)" aria-hidden="true">猫</p>
      <p class="neon vert small" style="--n:#22e6ff;right:3%;top:6%" aria-hidden="true">キーキャップ</p>
      <a class="neon enter" href="/lab/" aria-label="Enter the lab to do a cast" style="--n:#ff4a3d"><span>入口 ENTER</span><small>THE LAB</small></a>
      <a class="shopsign" href="/shop/" aria-label="Shop, closed for now">SHOP<small>closed ♡</small></a>

      <div class="ledge">
        <a class="monitor" href="/desk/studio.html" aria-label="Monitor: open the cymatic studio">
          <video autoplay loop muted playsinline poster="/cat-poster.webp" aria-label="A fluffy grey cat hugging a keyboard."><source src="/cat.webm" type="video/webm" /><source src="/cat.mp4" type="video/mp4" /></video>
        </a>
        <button class="obj candle" id="candle" aria-label="Candle: light or blow out" aria-pressed="true">
          <svg viewBox="0 0 34 60" aria-hidden="true"><path class="flame" d="M17 2Q25 14 17 24Q9 14 17 2Z" fill="#ffd27a"/><rect x="5" y="24" width="24" height="34" rx="5" fill="#ffc8ea" stroke="#2b1650" stroke-width="2"/></svg>
        </button>
        <a class="obj mug" href="/desk/#cafe" aria-label="Mug: cafe notes"><svg viewBox="0 0 54 50" aria-hidden="true"><path d="M38 16q15 1 12 15q-3 11-14 9" fill="none" stroke="#2b1650" stroke-width="6"/><path d="M38 16q15 1 12 15q-3 11-14 9" fill="none" stroke="#fff0fa" stroke-width="3"/><path d="M4 8H40L37 44Q22 49 7 44Z" fill="#fff0fa" stroke="#2b1650" stroke-width="2"/><ellipse cx="22" cy="9" rx="17" ry="4" fill="#9a6a45" stroke="#2b1650" stroke-width="2"/></svg></a>
        <a class="obj handheld" href="/desk/#play" aria-label="Handheld: games in progress"><svg viewBox="0 0 74 40" aria-hidden="true"><rect x="2" y="2" width="70" height="36" rx="13" fill="#ffb3d9" stroke="#2b1650" stroke-width="2"/><rect x="23" y="7" width="28" height="23" rx="2" fill="#7fe7ff" stroke="#2b1650" stroke-width="2"/><path d="M9 20h9M13.500 15v10" stroke="#fff" stroke-width="3" stroke-linecap="round"/><circle cx="60" cy="16" r="3" fill="#fff"/><circle cx="65" cy="24" r="3" fill="#fff"/></svg></a>
      </div>
    </div>
  </section>

  <section id="board" class="module onDesk">
    <KeycapBoard />
    <p class="index">01 / keyboard</p>
    <h2 class="chrome">Pull it apart</h2>
    <p>This is the keyboard on the desk. Drag the caps off and swap them, or type and watch the field below change. Mind the paw.</p>
  </section>

  <section id="field" class="module reveal">
    <p class="index">02 / cymatic field</p>
    <h2 class="chrome">Sing to it</h2>
    <p>Every key plays this field a new note. Turn on Live Voice and it follows your voice instead.</p>
    <Cymatics />
  </section>

  <section id="rooms" class="module reveal">
    <p class="index">03 / elsewhere</p>
    <h2 class="chrome">More rooms</h2>
    <div class="rooms">
      <a class="room lab" href="/lab/"><b>Resin Lab</b><span>Mix, pour, cure, reveal. Your cap comes back to the board up top.</span></a>
      <a class="room mydesk" href="/desk/"><b>Desk Notes</b><span>Kaps history, cafe notes and the brew calculator.</span></a>
      <a class="room desk" href="/lab/#desk"><b>Lab Desk</b><span>Pour-over, kettle, tarot cards, candle and the rainy window.</span></a>
      <a class="room wall" href="/wall/"><b>Graffiti Wall</b><span>Spray something. The public wall opens soon.</span></a>
      <a class="room shop" href="/shop/"><b>Shop</b><span>Closed for now. Peek in the window.</span></a>
      <a class="room blog" href="/blog/"><b>Blog</b><span>Incoming transmission...</span></a>
    </div>
    <p class="more"><a href="/works/">All experiments &rarr;</a></p>
  </section>
</Base>

<style>
  :global(#wavefield) { height: 1px; margin: 0; border: 0; opacity: 0; }
  :global(html) { background: #0a0614; }
  .rainy { position: fixed; inset: 0; z-index: -1; background:
    radial-gradient(70% 45% at 18% 16%, rgba(255,47,158,.34), transparent 70%),
    radial-gradient(70% 45% at 88% 30%, rgba(0,190,255,.26), transparent 70%),
    radial-gradient(90% 40% at 50% 96%, rgba(120,40,170,.3), transparent 70%), #0a0614; }
  .rainy::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle, rgba(255,255,255,.13) 1px, transparent 1.5px) 0 0 / 5px 5px; }
  .rainy::after { content: ""; position: absolute; inset: -80px 0 0; background: repeating-linear-gradient(97deg, transparent 0 37px, rgba(190,225,255,.13) 37px 38px, transparent 38px 91px, rgba(190,225,255,.08) 91px 92px); animation: rain 1.5s linear infinite; }
  @keyframes rain { to { transform: translate3d(-9px, 80px, 0); } }
  .opening { padding-top: .2rem; }
  .modak { margin: 0 0 .55rem; font: 400 clamp(2.05rem, 9.5vw, 3.3rem)/.95 "Modak", "Syne", sans-serif; letter-spacing: 0; background: linear-gradient(100deg,#fff 0%,#ffb6e4 18%,#d7f7ff 34%,#fff 46%,#b6a4ff 62%,#e8ffb0 78%,#fff 100%) 0 0 / 220% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: sheen 9s linear infinite; }
  @keyframes sheen { to { background-position: 220% 0; } }
  .prompt { margin: 0 0 .7rem; padding: .6rem .85rem; border: 1px solid rgba(255,245,251,.28); border-radius: 14px 14px 14px 4px; background: rgba(20,10,38,.7); backdrop-filter: blur(10px) saturate(1.5); -webkit-backdrop-filter: blur(10px) saturate(1.5); line-height: 1.35; }
  .band { position: relative; display: grid; grid-template-columns: minmax(0,.82fr) repeat(3, minmax(0,1fr)); height: clamp(270px, 68vw, 400px); width: 100%; overflow: hidden; border-block: 6px solid #0f0a14; box-shadow: 0 0 44px rgba(0,0,0,.75); }
  .pane { display: block; min-width: 0; border-inline: 4px solid #150e15; background:
    repeating-linear-gradient(90deg, transparent 0 calc(25% - 2px), #17101a calc(25% - 2px) 25%),
    repeating-linear-gradient(0deg, transparent 0 calc(20% - 2px), #17101a calc(20% - 2px) 20%),
    radial-gradient(90% 75% at 50% 42%, rgba(255,197,226,.62), rgba(100,44,108,.36) 62%, rgba(31,14,45,.76)); }
  .pane.third { filter: hue-rotate(58deg); }
  .pane.brick { position: relative; overflow: hidden; background: linear-gradient(#332a3e 2px, transparent 2px) 0 0 / 100% 18px, #211a2b; }
  .pane.brick svg { position: absolute; inset: 22% 4% auto; width: 92%; height: 52%; }
  .neon { position: absolute; margin: 0; padding: .3em .36em; font-family: "Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Yu Gothic", sans-serif; font-weight: 900; line-height: 1; color: #fff; text-decoration: none; background: rgba(10,4,20,.5); border: 1px solid rgba(255,255,255,.14); border-radius: 8px; text-shadow: 0 0 3px #fff, 0 0 8px var(--n), 0 0 18px var(--n), 0 0 34px var(--n), 0 0 60px var(--n); box-shadow: 0 0 24px color-mix(in srgb, var(--n) 42%, transparent); pointer-events: none; }
  .neon.vert { writing-mode: vertical-rl; text-orientation: upright; letter-spacing: .08em; font-size: clamp(30px, 8.6vw, 50px); }
  .neon.vert.small { font-size: clamp(13px, 3.5vw, 21px); }
  .enter { left: 56%; top: 38%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: clamp(21px, 6vw, 33px); white-space: nowrap; pointer-events: auto; animation: tube 5.2s linear infinite; }
  .enter span { color: #fff; }
  .enter small { font: 700 .4em/1 var(--font-body); letter-spacing: .2em; color: #ffd8d2; text-shadow: 0 0 7px var(--n); }
  .enter:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  /* an old tube: long steady stretches with short dips, never a fast strobe */
  @keyframes tube { 0%, 7%, 11%, 17%, 20%, 63%, 66%, 100% { opacity: 1; } 8%, 10%, 18%, 19%, 64%, 65% { opacity: .24; } }
  .shopsign { position: absolute; left: 1.5%; top: 3%; padding: .2em .5em; color: #16131b; background: #f6ede2; border-radius: 5px; font: 700 clamp(10px, 2.6vw, 13px)/1.1 var(--font-mono); text-align: center; text-decoration: none; transform: rotate(-3deg); }
  .shopsign small { display: block; font-size: .72em; color: #6e3a56; }
  .ledge { position: absolute; left: 0; right: 0; bottom: 0; height: 24%; display: flex; align-items: flex-end; justify-content: space-between; gap: 2%; padding: 0 3.5% 2.5%; background: linear-gradient(160deg, #fff0fa, #f6c8ea 45%, #d7e7ff 75%, #cfc2ff); box-shadow: 0 -2px 0 #fff, 0 -6px 16px rgba(0,0,0,.45); }
  .obj { display: block; padding: 0; min-height: 0; background: none; border: 0; cursor: pointer; transition: transform .2s; }
  .obj:hover, .obj:focus-visible { transform: translateY(-4px); }
  .obj:focus-visible, .monitor:focus-visible { outline: 2px solid #ff4a3d; outline-offset: 2px; }
  .obj svg { display: block; width: 100%; height: auto; overflow: visible; }
  .candle { width: 8%; margin-bottom: 1%; } .mug { width: 9.5%; } .handheld { width: 15%; }
  .monitor { display: block; width: 37%; aspect-ratio: 16 / 10; margin-bottom: 1.5%; padding: 1.2%; background: linear-gradient(135deg,#fff,#ff9bdc,#e9fbff,#9f8cff,#dcff8a); border: 2px solid #2b1650; border-radius: 9px; }
  .monitor video { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 5px; background: #000; }
  .flame { transform-box: fill-box; transform-origin: center bottom; animation: flick .3s infinite alternate; }
  @keyframes flick { to { transform: scaleY(.9) scaleX(1.08); } }
  .candle[aria-pressed="false"] .flame { display: none; }
  #board.onDesk { margin-top: 0; padding-top: .7rem; }
  @media (prefers-reduced-motion: reduce) { .rainy::after, .modak, .enter, .flame { animation: none; } }

  .hero { padding: 2.2rem 0 2rem; text-align: center; overflow-x: clip; }
  .portal { position: relative; width: min(100% - 34px, 380px); aspect-ratio: 1; margin: 0 auto 1.6rem; }
  .portal video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; border-radius: 50%; }
  /* a spinning liquid-chrome ring */
  .halo { position: absolute; inset: -12px; border-radius: 50%; background: conic-gradient(#fff, #9fa6c9, #ff7ab8, #e8ecff, #58d8f5, #8b8fb3, #fff); -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 7px), #000 calc(100% - 6px)); mask: radial-gradient(farthest-side, transparent calc(100% - 7px), #000 calc(100% - 6px)); filter: drop-shadow(0 0 16px rgba(160, 200, 255, .55)); animation: spin 9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .chrome { background: linear-gradient(175deg, #fff 8%, #aab1d6 38%, #fdfdff 50%, #8d86b8 62%, #ffc8e4 95%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  h1.chrome { margin: 0; font-size: clamp(2.1rem, 9.5vw, 3.6rem); letter-spacing: -.03em; overflow-wrap: anywhere; }
  .sys { margin: 0 0 .4rem; color: #58d8f5; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; }
  .rooms { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: .8rem; margin-top: 1rem; }
  .room { display: flex; flex-direction: column; gap: .3rem; min-height: 8.5rem; padding: 1rem; color: var(--ink); border: 1px solid #4b4466; border-radius: 12px; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .room b { font-family: var(--font-display); font-size: 1.25rem; }
  .room span { color: var(--muted); font-size: .88rem; line-height: 1.4; }
  .room:hover { transform: translateY(-3px); }
  .lab { background: linear-gradient(150deg, #3a0f4f, #12061d 70%); box-shadow: inset 0 0 22px rgba(255,119,180,.28); }
  .mydesk { background: linear-gradient(150deg, #264a5a, #14101f 75%); box-shadow: inset 0 0 22px rgba(255,122,184,.3); }
  .desk { background: linear-gradient(150deg, #5a2a4a, #1c0f24 75%); box-shadow: inset 0 0 22px rgba(255,190,120,.3); }
  .wall { background: repeating-linear-gradient(0deg, #231d30 0 26px, #1b1626 27px 28px); box-shadow: inset 0 0 22px rgba(216,255,62,.14); }
  .shop { background: linear-gradient(150deg, #e9ecff22, #16131b 75%); box-shadow: inset 0 0 22px rgba(255,255,255,.14); }
  .blog { background: #0d0b14; box-shadow: inset 0 0 22px rgba(88,216,245,.22); }
  .blog span { color: #58d8f5; font-family: var(--font-mono); font-size: .8rem; }
  .more { margin-top: 1rem; }
  .tag { margin: .5rem 0 1.3rem; color: var(--muted); font-family: var(--font-mono); font-size: .8rem; letter-spacing: .08em; }
  .down { display: inline-block; padding: .55rem 1.2rem; color: var(--ink); border: 1px solid #58d8f5; border-radius: 99px; box-shadow: 0 0 14px rgba(88, 216, 245, .35), inset 0 0 10px rgba(88, 216, 245, .2); font-family: var(--font-mono); font-size: .8rem; text-decoration: none; }

  .module { padding: 3.2rem 0 1rem; scroll-margin-top: 1rem; }
  .module h2 { margin: .2rem 0 .5rem; font-size: 2rem; }
  .index { margin: 0; color: #58d8f5; font-family: var(--font-mono); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; }

  /* sections drift up as they scroll into view, and stay readable the whole time */
  :global(html.js-reveal) .reveal { transform: translateY(26px); transition: transform .7s cubic-bezier(.2, .8, .2, 1); }
  :global(html.js-reveal) .reveal.shown { transform: none; }
  :global(html.js-reveal) .reveal.done { transform: none; transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .halo { animation: none; }
    :global(html.js-reveal) .reveal { transform: none; transition: none; }
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (still) document.querySelector<HTMLVideoElement>('.portal video')?.pause();
  document.documentElement.classList.add('js-reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('shown');
      io.unobserve(e.target);
      // drop the transform afterward so the fixed-position dragged cap and pop-up stay true to the screen
      setTimeout(() => e.target.classList.add('done'), 800);
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach((s) => io.observe(s));
</script>

<script>
  const candle = document.getElementById('candle');
  candle?.addEventListener('click', () => candle.setAttribute('aria-pressed', String(candle.getAttribute('aria-pressed') !== 'true')));
</script>
